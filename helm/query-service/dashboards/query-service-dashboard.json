{
  "title": "query-service",
  "uid": "query-service",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["telemetry-system", "query-service"],
  "panels": [
    {
      "title": "RPS — GET /devices*",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"query-service\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    },
    {
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"query-service\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"query-service\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"query-service\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Доля 404 (устройство не найдено в Redis)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"query-service\", status=\"404\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"query-service\"}[5m]))",
          "legendFormat": "404 ratio"
        }
      ]
    },
    {
      "title": "JVM heap, используемая память",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"query-service\", area=\"heap\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "title": "Готовые поды (readiness)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "count(kube_pod_status_ready{namespace=\"telemetry-system\", condition=\"true\", pod=~\"^query-service-.*\"})"
        }
      ]
    }
  ]
}
